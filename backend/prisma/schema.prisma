generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique // stored lowercase
  displayName  String
  email        String?    @unique
  passwordHash String // scrypt, see auth.ts
  role         Role       @default(user)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  spotify      SpotifyAccount?
  imports      SpotifyImport[]
  playlists    Playlist[]
  likes        Like[]
  plays        Play[]
  savedAlbums  SavedAlbum[]
  following    FollowedArtist[]
  podcasts     PodcastSubscription[]
  episodes     EpisodeProgress[]
}

model Session {
  id         String   @id // SHA-256 of the cookie token; the token itself is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?

  @@index([userId])
}

model Artist {
  id         String    @id @default(cuid())
  name       String    @unique
  // Filled from the Deezer API (see enrich.ts)
  deezerId   Int?
  pictureUrl String?
  enrichedAt DateTime? // last lookup attempt, matched or not
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  albums     Album[]
  tracks     Track[]
  followers  FollowedArtist[]
}

model Album {
  id         String    @id @default(cuid())
  title      String
  artistId   String
  artist     Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  year       Int?
  // Filled from the Deezer API (see enrich.ts)
  deezerId   Int?
  coverUrl   String?
  enrichedAt DateTime? // last lookup attempt, matched or not
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  tracks     Track[]
  savedBy    SavedAlbum[]

  @@unique([artistId, title])
}

// A file in MUSIC_DIR, indexed from its tags.
model Track {
  id           String          @id @default(cuid())
  deezerId     String?         @unique
  path         String          @unique // relative to MUSIC_DIR
  fileSize     Int
  fileMtime    DateTime
  indexVersion Int             @default(0) // files indexed by an older scanner get re-read
  title        String
  isrc         String? // from tags; deemix writes it, used to match on Deezer
  artistName   String // full artist tag as displayed, may list several artists
  artistId     String // primary artist
  artist       Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  albumId      String?
  album        Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  durationSec  Int?
  trackNumber  Int?
  discNumber   Int?
  coverPath    String? // folder cover relative to MUSIC_DIR; null means use embedded art
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  playlists    PlaylistTrack[]
  likes        Like[]
  plays        Play[]

  @@index([albumId])
  @@index([artistId])
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tracks      PlaylistTrack[]
  imports     SpotifyImport[]

  @@index([ownerId])
}

// An entry, not a track: the same track can appear twice in a playlist.
model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  // Fractional so moving an entry only rewrites that entry (placed between its new neighbours).
  position   Float
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
}

model Like {
  userId  String
  trackId String
  likedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, likedAt])
}

// Albums and artists in a user's library ("Enregistrer", "S'abonner"), like Spotify.
model SavedAlbum {
  userId  String
  albumId String
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@index([userId, savedAt])
}

model FollowedArtist {
  userId     String
  artistId   String
  followedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, followedAt])
}

model Play {
  id       String   @id @default(cuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}

// --- Podcasts ----------------------------------------------------------------

// A podcast's RSS feed, shared by every user; episodes stream from the publisher.
model Podcast {
  id            String                @id @default(cuid())
  feedUrl       String                @unique
  title         String
  author        String?
  description   String? // plain text
  imageUrl      String?
  link          String?
  fetchedAt     DateTime? // last successful refresh
  createdAt     DateTime              @default(now())
  episodes      PodcastEpisode[]
  subscribers   PodcastSubscription[]
}

model PodcastEpisode {
  id          String            @id @default(cuid())
  podcastId   String
  podcast     Podcast           @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  guid        String // from the feed, identifies the episode across refreshes
  title       String
  description String? // plain text
  audioUrl    String
  imageUrl    String?
  durationSec Int?
  publishedAt DateTime
  progress    EpisodeProgress[]

  @@unique([podcastId, guid])
  @@index([podcastId, publishedAt])
}

model PodcastSubscription {
  userId       String
  podcastId    String
  subscribedAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast      Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@id([userId, podcastId])
  @@index([podcastId])
}

// Where a user stopped in an episode, to resume it; completed once heard to the end.
model EpisodeProgress {
  userId      String
  episodeId   String
  positionSec Int
  completed   Boolean        @default(false)
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
}

// --- Spotify import ----------------------------------------------------------

model SpotifyAccount {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyUserId String
  displayName   String?
  // AES-256-GCM, see spotify/client.ts. Never returned by the API.
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  connectedAt   DateTime @default(now())
}

enum SpotifyImportStatus {
  running // reading the Spotify playlist and matching tracks
  waiting // some tracks are downloading through deemix
  done
  failed
}

model SpotifyImport {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null when importing the user's Spotify liked tracks
  spotifyPlaylistId String?
  name              String
  // Target playlist; null for liked tracks (they go to the user's likes)
  playlistId        String?
  playlist          Playlist?           @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  status            SpotifyImportStatus @default(running)
  error             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tracks            SpotifyImportTrack[]

  @@index([userId, createdAt])
}

enum SpotifyImportTrackStatus {
  pending // read from Spotify, not processed yet
  matched // in the library and added to the playlist / likes
  queued // sent to deemix, waiting for the file to be scanned
  not_found // neither in the library nor on Deezer
}

model SpotifyImportTrack {
  id         String                   @id @default(cuid())
  importId   String
  import     SpotifyImport            @relation(fields: [importId], references: [id], onDelete: Cascade)
  position   Int // order in the Spotify playlist, kept in the local one
  addedAt    DateTime? // when it was added on Spotify (used for liked tracks)
  title      String
  artist     String
  album      String?
  isrc       String?
  deezerIsrc String? // ISRC of the Deezer track that was downloaded, may differ
  status     SpotifyImportTrackStatus
  trackId    String? // local track once matched

  @@index([importId, position])
  @@index([status])
}
