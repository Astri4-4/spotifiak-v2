# Postgres
POSTGRES_PASSWORD=change-me

# Deemix instance in the homelab
DEEMIX_URL=http://deemix.lan:6595
# Deezer ARL cookie, if your deemix needs a login to download
DEEMIX_ARL=

# Host folder where deemix writes downloads (mounted read-only into the API)
MUSIC_DIR=/mnt/music
# Quick rescans of MUSIC_DIR for new or removed files, in seconds (0 disables)
SCAN_INTERVAL_SEC=300
# Full rescans, which also catch files modified in place, in hours (0 disables)
FULL_SCAN_INTERVAL_HOURS=24

# Port of the web interface (the API is reached through it under /api)
WEB_PORT=8080

# Accounts: the first account created becomes admin. With ALLOW_SIGNUP=false,
# admins create the other accounts; true lets anyone sign up.
ALLOW_SIGNUP=false
# true when Spotifiak is served over HTTPS (session cookie sent over HTTPS only)
COOKIE_SECURE=false

# Fetch album covers and artist pictures from Deezer's public API (no key needed)
DEEZER_ENRICH=true
