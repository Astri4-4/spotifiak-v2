# Postgres
POSTGRES_PASSWORD=change-me

# Deemix instance in the homelab
DEEMIX_URL=http://deemix.lan:6595
# Deezer ARL cookie, if your deemix needs a login to download
DEEMIX_ARL=

# Host folder where deemix writes downloads (mounted read-only into the API)
MUSIC_DIR=/mnt/music
# How often to rescan MUSIC_DIR for new or changed files (0 disables)
SCAN_INTERVAL_SEC=300

# Public URLs, as seen from the browser
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:8080

# Fetch album covers and artist pictures from Deezer's public API (no key needed)
DEEZER_ENRICH=true
